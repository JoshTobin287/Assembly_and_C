000013B0                           441  *-----------------------------------------------------------
000013B0                           442  IS_PLAYER_ON_GND:
000013B0                           443      ; Check if Player is on Ground
000013B0  4281                     444      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
000013B2  4282                     445      CLR.L   D2                      ; Clear contents of D2 (XOR is faster)
000013B4  3239 00001860            446      MOVE.W  SCREEN_H,   D1          ; Place Screen width in D1
000013BA  82FC 0002                447      DIVU    #02,        D1          ; divide by 2 for center on Y Axis
000013BE  2439 0000186A            448      MOVE.L  PLAYER_Y,   D2          ; Player Y Position
000013C4  B481                     449      CMP.L     D1,         D2        ; Compare middle of Screen with Players Y Position 
000013C6  6D00 002A                450      BLT     SET_OFF_GROUND           ; The Player is on the Ground Plane
000013CA  6000 0002                451      BRA     SET_ON_GROUND          ; The Player is off the Ground
000013CE                           452                                
000013CE                           453  
