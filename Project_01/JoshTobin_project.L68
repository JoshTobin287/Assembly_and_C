00001534  B481                     613      CMP.L D1, D2
00001536  6C00 0006                614      BGE PLAYER_Y_OK
0000153A  6000 0036                615      BRA SKIP_FUEL_COLLIDE
0000153E                           616  PLAYER_Y_OK:
0000153E  2239 00001614            617      MOVE.L PLAYER_Y, D1
00001544  2439 00001644            618      MOVE.L FUEL_Y, D2
0000154A  5082                     619      ADD.L #8, D2             ; Fuel height
0000154C  B481                     620      CMP.L D1, D2
0000154E  6F00 0006                621      BLE FUEL_COLLECTED
00001552  6000 001E                622      BRA SKIP_FUEL_COLLIDE
00001556                           623  
