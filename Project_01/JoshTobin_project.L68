00001104                           166  * Subroutine    : Input
00001104                           167  * Description   : Process Keyboard Input
00001104                           168  *-----------------------------------------------------------
00001104                           169  INPUT:
00001104                           170      ; Process Input
00001104  4281                     171      CLR.L   D1                      ; Clear Data Register
00001106  103C 0013                172      MOVE.B  #TC_KEYCODE,D0          ; Listen for Keys
0000110A  4E4F                     173      TRAP    #15                     ; Trap (Perform action)
0000110C  1401                     174      MOVE.B  D1,         D2          ; Move last key D1 to D2
0000110E  B43C 0000                175      CMP.B   #00,        D2          ; Key is pressed
00001112  6700 000E                176      BEQ     PROCESS_INPUT           ; Process Key
00001116  4E4F                     177      TRAP    #15                     ; Trap for Last Key
00001118                           178      ; Check if key still pressed
00001118  B23C 00FF                179      CMP.B   #$FF,       D1          ; Is it still pressed
0000111C  6700 0004                180      BEQ     PROCESS_INPUT           ; Process Last Key
00001120  4E75                     181      RTS                             ; Return to subroutine
00001122                           182  
00001122                           183  *-----------------------------------------------------------
00001122                           184  * Subroutine    : Process Input
00001122                           185  * Description   : Branch based on keys pressed
00001122                           186  *-----------------------------------------------------------
00001122                           187  PROCESS_INPUT:
00001122  23C2 0000160C            188      MOVE.L  D2,         CURRENT_KEY ; Put Current Key in Memory
00001128  0CB9 0000001B 0000160C   189      CMP.L   #ESCAPE,    CURRENT_KEY ; Is Current Key Escape
00001132  6700 0440                190      BEQ     EXIT                    ; Exit if Escape
00001136  0CB9 00000020 0000160C   191      CMP.L   #SPACEBAR,  CURRENT_KEY ; Is Current Key Spacebar
00001140  6700 01F2                192      BEQ     JUMP                    ; Jump
00001144  6000 0224                193      BRA     IDLE                    ; Or Idle
00001148  4E75                     194      RTS                             ; Return to subroutine
0000114A                           195  
