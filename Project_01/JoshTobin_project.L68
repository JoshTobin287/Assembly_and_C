00001174                           218  INPUT:
00001174                           219      ; Process Input
00001174  4281                     220      CLR.L   D1                      ; Clear Data Register
00001176  103C 0013                221      MOVE.B  #TC_KEYCODE,D0          ; Listen for Keys
0000117A  4E4F                     222      TRAP    #15                     ; Trap (Perform action)
0000117C  1401                     223      MOVE.B  D1,         D2          ; Move last key D1 to D2
0000117E  B43C 0000                224      CMP.B   #00,        D2          ; Key is pressed
00001182  6700 000E                225      BEQ     PROCESS_INPUT           ; Process Key
00001186  4E4F                     226      TRAP    #15                     ; Trap for Last Key
00001188                           227      ; Check if key still pressed
00001188  B23C 00FF                228      CMP.B   #$FF,       D1          ; Is it still pressed
0000118C  6700 0004                229      BEQ     PROCESS_INPUT           ; Process Last Key
00001190  4E75                     230      RTS                             ; Return to subroutine
00001192                           231  
