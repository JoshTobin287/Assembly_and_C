0000151A  2439 00001640            605      MOVE.L FUEL_X, D2
00001520  5082                     606      ADD.L #8, D2            ; Fuel width (example 8)
00001522  B481                     607      CMP.L D1, D2
00001524  6F00 0006                608      BLE PLAYER_X_OK
00001528  6000 0048                609      BRA SKIP_FUEL_COLLIDE
