00001570                           641  
00001570                           642  *-----------------------------------------------------------
00001570                           643  * Subroutine    : Collision Check
00001570                           644  * Description   : Axis-Aligned Bounding Box Collision Detection
00001570                           645  * Algorithm checks for overlap on the 4 sides of the Player and 
00001570                           646  * Enemy rectangles
00001570                           647  * PLAYER_X <= ENEMY_X + ENEMY_W &&
00001570                           648  * PLAYER_X + PLAYER_W >= ENEMY_X &&
00001570                           649  * PLAYER_Y <= ENEMY_Y + ENEMY_H &&
00001570                           650  * PLAYER_H + PLAYER_Y >= ENEMY_Y
00001570                           651  *-----------------------------------------------------------
00001570                           652  CHECK_COLLISIONS:
00001570                           653  
00001570                           654  ; -----------------------------
00001570                           655  ; Check Small Zombie Collision
00001570                           656  ; -----------------------------
00001570  4281                     657      CLR.L   D1
00001572  4282                     658      CLR.L   D2
00001574                           659  
00001574                           660  ; X-axis: PLAYER_X <= SMALLZOMB_X + WIDTH
00001574  2239 00001866            661      MOVE.L  PLAYER_X, D1
0000157A  2439 00001882            662      MOVE.L  SMALLZOMB_X, D2
00001580  D4B8 0008                663      ADD.L   SMALLZOMB_W_INIT, D2
00001584  B481                     664      CMP.L   D1, D2
00001586  6E00 004C                665      BGT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
0000158A                           666  
0000158A                           667  ; X-axis: PLAYER_X + PLAYER_W >= SMALLZOMB_X
0000158A  2239 00001866            668      MOVE.L  PLAYER_X, D1
00001590  D2B8 0008                669      ADD.L   PLYR_W_INIT, D1
00001594  2439 00001882            670      MOVE.L  SMALLZOMB_X, D2
0000159A  B481                     671      CMP.L   D1, D2
0000159C  6D00 0036                672      BLT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
000015A0                           673  
000015A0                           674  ; Y-axis: PLAYER_Y <= SMALLZOMB_Y + HEIGHT
000015A0  2239 0000186A            675      MOVE.L  PLAYER_Y, D1
000015A6  2439 00001886            676      MOVE.L  SMALLZOMB_Y, D2
000015AC  D4B8 0008                677      ADD.L   SMALLZOMB_H_INIT, D2
000015B0  B481                     678      CMP.L   D1, D2
000015B2  6E00 0020                679      BGT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
000015B6                           680  
000015B6                           681  ; Y-axis: PLAYER_Y + PLAYER_H >= SMALLZOMB_Y
000015B6  2239 0000186A            682      MOVE.L  PLAYER_Y, D1
000015BC  D2B8 0008                683      ADD.L   PLYR_H_INIT, D1
000015C0  2439 00001886            684      MOVE.L  SMALLZOMB_Y, D2
000015C6  B481                     685      CMP.L   D1, D2
000015C8  6D00 000A                686      BLT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
000015CC                           687  
000015CC                           688  ; Collision confirmed!
000015CC  6100 0114                689      BSR     SMALLZOMB_COLLISION
000015D0  6000 0102                690      BRA     COLLISION_CHECK_DONE
000015D4                           691  
000015D4                           692  ; -----------------------------
000015D4                           693  ; Check Large Zombie Collision
000015D4                           694  ; -----------------------------
000015D4                           695      CHECK_LARGEZOMB_COLLISION:
000015D4  4281                     696      CLR.L   D1
000015D6  4282                     697      CLR.L   D2
000015D8                           698  
000015D8                           699  ; X-axis: PLAYER_X <= LARGEZOMB_X + WIDTH
000015D8  2239 00001866            700      MOVE.L  PLAYER_X, D1
000015DE  2439 0000188A            701      MOVE.L  LARGEZOMB_X, D2
000015E4  D4B8 0010                702      ADD.L   LARGEZOMB_W_INIT, D2
000015E8  B481                     703      CMP.L   D1, D2
000015EA  6E00 0048                704      BGT     CHECK_FUEL_COLLISION  ; skip if no overlap
000015EE                           705  
000015EE                           706  ; X-axis: PLAYER_X + PLAYER_W >= LARGEZOMB_X
000015EE  2239 00001866            707      MOVE.L  PLAYER_X, D1
000015F4  D2B8 0008                708      ADD.L   PLYR_W_INIT, D1
000015F8  2439 0000188A            709      MOVE.L  LARGEZOMB_X, D2
000015FE  B481                     710      CMP.L   D1, D2
00001600  6D00 0032                711      BLT     CHECK_FUEL_COLLISION  ; skip if no overlap
00001604                           712  
00001604                           713  ; Y-axis: PLAYER_Y <= LARGEZOMB_Y + HEIGHT
00001604  2239 0000186A            714      MOVE.L  PLAYER_Y, D1
0000160A  2439 0000188E            715      MOVE.L  LARGEZOMB_Y, D2
00001610  D4B8 0010                716      ADD.L   LARGEZOMB_H_INIT, D2
00001614  B481                     717      CMP.L   D1, D2
00001616  6E00 001C                718      BGT     CHECK_FUEL_COLLISION  ; skip if no overlap
0000161A                           719  
0000161A                           720  ; Y-axis: PLAYER_Y + PLAYER_H >= LARGEZOMB_Y
0000161A  2239 0000186A            721       MOVE.L  PLAYER_Y, D1
00001620  D2B8 0008                722      ADD.L   PLYR_H_INIT, D1
00001624  2439 0000188E            723      MOVE.L  LARGEZOMB_Y, D2
0000162A  B481                     724      CMP.L   D1, D2
0000162C  6D00 0006                725      BLT     CHECK_FUEL_COLLISION  ; skip if no overlap
00001630                           726  
00001630                           727     ; Collision confirmed!
00001630  6100 00DC                728     BSR     LARGEZOMB_COLLISION
00001634                           729  
00001634                           730  ; -----------------------------
00001634                           731  ; Check Fuel Collision
00001634                           732  ; -----------------------------
00001634                           733  CHECK_FUEL_COLLISION:
00001634                           734  ; ... your existing fuel collision code ...
00001634                           735      
00001634                           736  CHECK_FUEL_COLLISION:
00001634                           737  
00001634  0CB9 00000001 000018AE   738      CMP.L   #1, FUEL_ACTIVE          ; Is the fuel currently visible?
0000163E  6600 0094                739      BNE     COLLISION_CHECK_DONE     ; If not active, skip collision check
00001642                           740  
00001642  4281                     741      CLR.L   D1                        ; Clear D1 for calculations
00001644  4282                     742      CLR.L   D2                        ; Clear D2 for calculations
00001646                           743  
00001646                           744  
00001646                           745      ; Check X-axis overlap
00001646  2239 00001866            746      MOVE.L  PLAYER_X, D1              ; Load player X position
0000164C  2439 000018A6            747      MOVE.L  FUEL_X, D2                ; Load fuel X position
00001652  D4B8 0008                748      ADD.L   FUEL_W_INIT, D2           ; Add fuel width to get right edge
00001656  B481                     749      CMP.L   D1, D2                     ; Compare left side of player with right side of fuel
00001658  6F00 0006                750      BLE     FUEL_X2_CHECK              ; If player left <= fuel right, continue X check
0000165C  6000 0076                751      BRA     COLLISION_CHECK_DONE       ; Otherwise, no collision
00001660                           752  
00001660                           753  FUEL_X2_CHECK:
00001660                           754      ; Check second X-axis overlap: PLAYER_X + PLAYER_W_INIT >= FUEL_X
00001660  D2B8 0008                755      ADD.L   PLYR_W_INIT, D1           ; Add player width to get right side of player
00001664  2439 000018A6            756      MOVE.L  FUEL_X, D2                ; Reload fuel X
0000166A  B481                     757      CMP.L   D1, D2                     ; Compare right side of player to left side of fuel
0000166C  6C00 0006                758      BGE     FUEL_Y1_CHECK              ; If player right >= fuel left, continue Y check
00001670  6000 0062                759      BRA     COLLISION_CHECK_DONE       ; Otherwise, no collision
00001674                           760  
00001674                           761  FUEL_Y1_CHECK:
00001674                           762      ; Check Y-axis overlap: PLAYER_Y <= FUEL_Y + FUEL_H_INIT
00001674  2239 0000186A            763      MOVE.L  PLAYER_Y, D1              ; Load player Y position
0000167A  2439 000018AA            764      MOVE.L  FUEL_Y, D2                ; Load fuel Y position
00001680  D4B8 000E                765      ADD.L   FUEL_H_INIT, D2           ; Add fuel height to get bottom of fuel
00001684  B481                     766      CMP.L   D1, D2                     ; Compare top of player with bottom of fuel
00001686  6F00 0006                767      BLE     FUEL_Y2_CHECK              ; If player top <= fuel bottom, continue Y check
0000168A  6000 0048                768      BRA     COLLISION_CHECK_DONE       ; Otherwise, no collision
0000168E                           769  
0000168E                           770  FUEL_Y2_CHECK:
0000168E                           771      ; Check second Y-axis overlap
0000168E  D2B8 0008                772      ADD.L   PLYR_H_INIT, D1           ; Add player height to get bottom of player
00001692  2439 000018AA            773      MOVE.L  FUEL_Y, D2                ; Reload fuel Y
00001698  B481                     774      CMP.L   D1, D2                     ; Compare bottom of player with top of fuel
0000169A  6C00 0006                775      BGE     FUEL_COLLECTED             ; If overlap confirmed, fuel collected
0000169E  6000 0034                776      BRA     COLLISION_CHECK_DONE       ; Otherwise, no collision
000016A2                           777  
000016A2                           778  FUEL_COLLECTED:
000016A2                           779      ;Fuel collected, update fuel and hide
000016A2  2239 0000189A            780      MOVE.L  FUEL, D1                  ; Load current fuel amount
000016A8  0681 0000000F            781      ADD.L   #15, D1                   ; Add 15 fuel (adjustable)
