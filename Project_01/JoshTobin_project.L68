0000146C                           537  *-----------------------------------------------------------
0000146C                           538  * Subroutine    : Collision Check
0000146C                           539  * Description   : Axis-Aligned Bounding Box Collision Detection
0000146C                           540  * Algorithm checks for overlap on the 4 sides of the Player and 
0000146C                           541  * Enemy rectangles
0000146C                           542  * PLAYER_X <= ENEMY_X + ENEMY_W &&
0000146C                           543  * PLAYER_X + PLAYER_W >= ENEMY_X &&
0000146C                           544  * PLAYER_Y <= ENEMY_Y + ENEMY_H &&
0000146C                           545  * PLAYER_H + PLAYER_Y >= ENEMY_Y
0000146C                           546  *-----------------------------------------------------------
0000146C                           547  CHECK_COLLISIONS:
0000146C  4281                     548      CLR.L   D1                      ; Clear D1
0000146E  4282                     549      CLR.L   D2                      ; Clear D2
00001470                           550  PLAYER_X_LTE_TO_ENEMY_X_PLUS_W:
00001470  2239 00001610            551      MOVE.L  PLAYER_X,   D1          ; Move Player X to D1
00001476  2439 0000162C            552      MOVE.L  ENEMY_X,    D2          ; Move Enemy X to D2
0000147C  D4B8 0008                553      ADD.L   ENMY_W_INIT,D2          ; Set Enemy width X + Width
00001480  B481                     554      CMP.L   D1,         D2          ; Do the Overlap ?
00001482  6F00 0006                555      BLE     PLAYER_X_PLUS_W_LTE_TO_ENEMY_X  ; Less than or Equal ?
00001486  6000 0044                556      BRA     COLLISION_CHECK_DONE    ; If not no collision
0000148A                           557  PLAYER_X_PLUS_W_LTE_TO_ENEMY_X:     ; Check player is not  
0000148A  D2B8 0008                558      ADD.L   PLYR_W_INIT,D1          ; Move Player Width to D1
0000148E  2439 0000162C            559      MOVE.L  ENEMY_X,    D2          ; Move Enemy X to D2
00001494  B481                     560      CMP.L   D1,         D2          ; Do they OverLap ?
00001496  6C00 0006                561      BGE     PLAYER_Y_LTE_TO_ENEMY_Y_PLUS_H  ; Less than or Equal
0000149A  6000 0030                562      BRA     COLLISION_CHECK_DONE    ; If not no collision   
0000149E                           563  PLAYER_Y_LTE_TO_ENEMY_Y_PLUS_H:     
0000149E  2239 00001614            564      MOVE.L  PLAYER_Y,   D1          ; Move Player Y to D1
000014A4  2439 00001630            565      MOVE.L  ENEMY_Y,    D2          ; Move Enemy Y to D2
000014AA  D4B8 0008                566      ADD.L   ENMY_H_INIT,D2          ; Set Enemy Height to D2
000014AE  B481                     567      CMP.L   D1,         D2          ; Do they Overlap ?
000014B0  6F00 0006                568      BLE     PLAYER_Y_PLUS_H_LTE_TO_ENEMY_Y  ; Less than or Equal
000014B4  6000 0016                569      BRA     COLLISION_CHECK_DONE    ; If not no collision 
000014B8                           570  PLAYER_Y_PLUS_H_LTE_TO_ENEMY_Y:     ; Less than or Equal ?
000014B8  D2B8 0008                571      ADD.L   PLYR_H_INIT,D1          ; Add Player Height to D1
000014BC  2439 00001630            572      MOVE.L  ENEMY_Y,    D2          ; Move Enemy Height to D2  
000014C2  B481                     573      CMP.L   D1,         D2          ; Do they OverLap ?
000014C4  6C00 0016                574      BGE     COLLISION               ; Collision !
000014C8  6000 0002                575      BRA     COLLISION_CHECK_DONE    ; If not no collision
000014CC                           576  COLLISION_CHECK_DONE:               ; No Collision Update points
000014CC  5281                     577      ADD.L   #POINTS,    D1          ; Move points upgrade to D1
000014CE  D2B9 0000161C            578      ADD.L   PLAYER_SCORE,D1         ; Add to current player score
000014D4  23C1 0000161C            579      MOVE.L  D1, PLAYER_SCORE        ; Update player score in memory
000014DA  4E75                     580      RTS                             ; Return to subroutine
000014DC                           581  
000014DC                           582  COLLISION:
000014DC  6100 FEE0                583      BSR     PLAY_OPPS               ; Play Opps Wav
000014E0  23FC 00000000 0000161C   584      MOVE.L  #00, PLAYER_SCORE       ; Reset Player Score
000014EA                           585      
000014EA                           586      ;increase kill counter
000014EA  2239 00001634            587      MOVE.L KILL_COUNT,D1
000014F0  5281                     588      ADD.L #1, D1
000014F2  23C1 00001634            589      MOVE.L D1, KILL_COUNT
000014F8                           590  
000014F8                           591  
000014F8                           592      ;MAKE ENEMY DISAPPEAR
000014F8  4281                     593      CLR.L   D1                      ; Clear D1
000014FA  3239 00001608            594      MOVE.W  SCREEN_W, D1            ; Get screen width
00001500  23C1 0000162C            595      MOVE.L  D1, ENEMY_X             ; Move enemy back to right side
00001506                           596      
00001506                           597      ; Only if fuel is active
00001506  0CB9 00000001 00001648   598      CMP.L #1, FUEL_ACTIVE
00001510  6600 0060                599      BNE SKIP_FUEL_COLLIDE
00001514                           600  
