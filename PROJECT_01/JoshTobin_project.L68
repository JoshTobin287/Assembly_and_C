000014A6  4281                     551      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
000014A8  3239 00001AAA            552      MOVE.W  SCREEN_H,   D1          ; Place Screen width in D1
000014AE  82FC 0002                553      DIVU    #02,        D1          ; divide by 2 for center on Y Axis
000014B2  23C1 00001AB4            554      MOVE.L  D1,         PLAYER_Y    ; Reset the Player Y Position
000014B8  42B9 00001AC0            555      CLR.L   PLYR_VELOCITY                     ; Clear contents of D1 (XOR is faster)
000014BE  23FC 00000001 00001AC8   556      MOVE.L  #GND_TRUE,  PLYR_ON_GND ; Player is on Ground
000014C8  4E75                     557      RTS
000014CA                           558  
