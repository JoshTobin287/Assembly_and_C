0000123C                           295  * Subroutine    : Update
0000123C                           296  * Description   : Main update loop update Player and Enemies
0000123C                           297  *-----------------------------------------------------------
0000123C                           298  UPDATE:
0000123C                           299  
0000123C                           300      ; Decrease jump cooldown if active
0000123C  0CB9 00000000 00001AB8   301      CMP.L   #0, JUMP_TIMER
00001246  6700 0008                302      BEQ     SKIP_TIMER_DEC
0000124A  53B9 00001AB8            303      SUB.L   #1, JUMP_TIMER
00001250                           304      
00001250                           305  SKIP_TIMER_DEC:
00001250                           306      
00001250  0CB9 00000001 00001B1C   307      CMP.L   #1, FUEL_ACTIVE          ; Is fuel currently visible?
0000125A  6600 002E                308      BNE     HANDLE_FUEL_RESPAWN      ; If NOT active, handle respawn timer
0000125E                           309  
0000125E                           310      ;fuel is active
0000125E  2239 00001B14            311      MOVE.L  FUEL_X, D1               ; Load current fuel X position
00001264  5381                     312      SUB.L   #1, D1                   ; Move fuel left by 1 pixel
00001266  23C1 00001B14            313      MOVE.L  D1, FUEL_X               ; Store new X position
0000126C                           314  
0000126C  B2BC 00000000            315      CMP.L   #0, D1                   ; Has fuel gone off left side?
00001272  6E00 0046                316      BGT     FUEL_DONE                ; If still on screen, finish update
00001276                           317  
00001276  23FC 00000000 00001B1C   318      MOVE.L  #0, FUEL_ACTIVE          ; Off screen ? hide fuel
00001280  42B9 00001B10            319      CLR.L   FUEL_RESPAWN_TIMER       ; Reset respawn timer to 0
00001286  6000 0032                320      BRA     FUEL_DONE                ; Skip respawn logic for now
0000128A                           321        
0000128A                           322      ; fuel is not active
0000128A                           323  HANDLE_FUEL_RESPAWN:
0000128A  52B9 00001B10            324      ADD.L   #1, FUEL_RESPAWN_TIMER   ; Increase respawn timer each frame
00001290  0CB9 000000B4 00001B10   325      CMP.L   #180, FUEL_RESPAWN_TIMER ; Wait about 3 seconds (180 frames at 60fps)
0000129A  6D00 001E                326      BLT     FUEL_DONE                ; If not reached yet, exit update
0000129E                           327  
0000129E                           328       ; Respawn fuel
