00001784                           867  CHECK_FUEL_COLLISION:
00001784                           868  
00001784  0CB9 00000001 00001B08   869      CMP.L   #1, FUEL_ACTIVE          ; Is the fuel currently visible?
0000178E  6600 0094                870      BNE     COLLISION_CHECK_DONE    ; If not active, skip collision check
00001792                           871  
00001792  4281                     872      CLR.L   D1                        ; Clear D1 for calculations
00001794  4282                     873      CLR.L   D2                        ; Clear D2 for calculations
00001796                           874  
00001796                           875  
00001796                           876      ; Check X-axis overlap
00001796  2239 00001AB0            877      MOVE.L  PLAYER_X, D1              ; Load player X position
0000179C  2439 00001B00            878      MOVE.L  FUEL_X, D2                ; Load fuel X position
000017A2  D4B8 0008                879      ADD.L   FUEL_W_INIT, D2           ; Add fuel width to get right edge
000017A6  B481                     880      CMP.L   D1, D2                     ; Compare left side of player with right side of fuel
000017A8  6F00 0006                881      BLE     FUEL_X2_CHECK              ; If player left <= fuel right, continue X check
000017AC  6000 0076                882      BRA     COLLISION_CHECK_DONE         ; Otherwise, no collision
000017B0                           883  
000017B0                           884  FUEL_X2_CHECK:
000017B0                           885      ; Check second X-axis overlap: PLAYER_X + PLAYER_W_INIT >= FUEL_X
000017B0  D2B8 0008                886      ADD.L   PLYR_W_INIT, D1           ; Add player width to get right side of player
000017B4  2439 00001B00            887      MOVE.L  FUEL_X, D2                ; Reload fuel X
000017BA  B481                     888      CMP.L   D1, D2                     ; Compare right side of player to left side of fuel
000017BC  6C00 0006                889      BGE     FUEL_Y1_CHECK              ; If player right >= fuel left, continue Y check
000017C0  6000 0062                890      BRA     COLLISION_CHECK_DONE        ; Otherwise, no collision
000017C4                           891  
000017C4                           892  FUEL_Y1_CHECK:
000017C4                           893      ; Check Y-axis overlap: PLAYER_Y <= FUEL_Y + FUEL_H_INIT
000017C4  2239 00001AB4            894      MOVE.L  PLAYER_Y, D1              ; Load player Y position
000017CA  2439 00001B04            895      MOVE.L  FUEL_Y, D2                ; Load fuel Y position
000017D0  D4B8 000E                896      ADD.L   FUEL_H_INIT, D2           ; Add fuel height to get bottom of fuel
000017D4  B481                     897      CMP.L   D1, D2                     ; Compare top of player with bottom of fuel
000017D6  6F00 0006                898      BLE     FUEL_Y2_CHECK              ; If player top <= fuel bottom, continue Y check
000017DA  6000 0048                899      BRA     COLLISION_CHECK_DONE       ; Otherwise, no collision
000017DE                           900  
000017DE                           901  FUEL_Y2_CHECK:
000017DE                           902      ; Check second Y-axis overlap
000017DE  D2B8 0008                903      ADD.L   PLYR_H_INIT, D1           ; Add player height to get bottom of player
000017E2  2439 00001B04            904      MOVE.L  FUEL_Y, D2                ; Reload fuel Y
000017E8  B481                     905      CMP.L   D1, D2                     ; Compare bottom of player with top of fuel
000017EA  6C00 0006                906      BGE     FUEL_COLLECTED             ; If overlap confirmed, fuel collected
000017EE  6000 0034                907      BRA     COLLISION_CHECK_DONE         ; Otherwise, no collision
000017F2                           908  
000017F2                           909  FUEL_COLLECTED:
000017F2                           910      ;Fuel collected, update fuel and hide
000017F2  2239 00001AF4            911      MOVE.L  FUEL, D1                  ; Load current fuel amount
000017F8  0681 0000000C            912      ADD.L   #12, D1                   ; Add 15 fuel (adjustable)
000017FE  B2BC 00000064            913      CMP.L   #FUEL_MAX,  D1                   ;check if it goes over max
00001804  6F00 0004                914      BLE     FUEL_OK                     ;if fuel is is <= 100, then ok
00001808  7264                     915      MOVE.L  #FUEL_MAX,  D1                ;otherwise stay to 100
