00001300                           381  
00001300  4281                     382      CLR.L   D1
00001302  2239 00001AD2            383      MOVE.L  LARGEZOMB_X, D1      ; Load large zombie X
00001308  B2BC 00000000            384      CMP.L   #0, D1               ; Has it reached left side?
0000130E  6F00 0094                385      BLE     RESET_LARGE_ZOMBIE   ; If yes reset it
00001312                           386  
00001312                           387  ;-----------------------------------
00001312                           388  ; Move both zombies
00001312                           389  ;-----------------------------------
00001312                           390  
00001312  6100 0056                391      BSR     MOVE_ZOMBIE
00001316                           392  
00001316                           393      ; Move building left
00001316  53B9 00001ADA            394      SUB.L #1, BUILDING_X               ; Move 1 pixel left
0000131C                           395      ; Reset building if it is offscreen (like small zombie)
0000131C  0CB9 00000000 00001ADA   396      CMP.L #0, BUILDING_X
00001326  6C00 000E                397      BGE SKIP_BUILDING_RESET
0000132A                           398      ; Offscreen: reset to right side
0000132A  3239 00001AA2            399      MOVE.W SCREEN_W, D1
00001330  23C1 00001ADA            400      MOVE.L D1, BUILDING_X
00001336                           401  
00001336                           402  
00001336                           403  SKIP_BUILDING_RESET:
00001336                           404  
00001336                           405      ;Fuel Cowuntdown
00001336  52B9 00001AF2            406      ADD.L   #1, FUEL_TIMER          ; increment timer per update
0000133C  0CB9 0000003C 00001AF2   407      CMP.L   #60, FUEL_TIMER         ; check if ~1 second passed (adjust if needed)
00001346  6D00 0020                408      BLT     SKIP_FUEL_DECREMENT     ; if not, skip decrement
0000134A  53B9 00001AEE            409      SUB.L   #1, FUEL                ; decrease fuel by 1
00001350  42B9 00001AF2            410      CLR.L   FUEL_TIMER              ; reset timer
00001356  0CB9 00000000 00001AEE   411      CMP.L   #0, FUEL
00001360  6E00 0006                412      BGT     SKIP_GAME_OVER          ; if fuel > 0, skip game over
00001364  6100 0532                413      BSR     EXIT                     ; fuel is 0 ? end game
00001368                           414  SKIP_FUEL_DECREMENT:             ; label to continue normal update
00001368                           415  SKIP_GAME_OVER:
00001368                           416              
00001368  4E75                     417      RTS                             ; Return to subroutine  
