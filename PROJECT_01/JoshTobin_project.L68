00001516  303C 0047                592      MOVE    #71,        D0          ; Load into memory
0000151A  4E4F                     593      TRAP    #15                     ; Trap (Perform action)
0000151C  4E75                     594      RTS                             ; Return to subroutine
0000151E                           595  
