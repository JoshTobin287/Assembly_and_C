000016C0                           776  * Subroutine    : Collision Check
000016C0                           777  * Description   : Axis-Aligned Bounding Box Collision Detection
000016C0                           778  * Algorithm checks for overlap on the 4 sides of the Player and 
000016C0                           779  * Enemy rectangles
000016C0                           780  * PLAYER_X <= ENEMY_X + ENEMY_W &&
000016C0                           781  * PLAYER_X + PLAYER_W >= ENEMY_X &&
000016C0                           782  * PLAYER_Y <= ENEMY_Y + ENEMY_H &&
000016C0                           783  * PLAYER_H + PLAYER_Y >= ENEMY_Y
000016C0                           784  *-----------------------------------------------------------
000016C0                           785  CHECK_COLLISIONS:
000016C0                           786  
000016C0                           787  ; -----------------------------
000016C0                           788  ; Check Small Zombie Collision
000016C0                           789  ; -----------------------------
000016C0  4281                     790      CLR.L   D1
000016C2  4282                     791      CLR.L   D2
000016C4                           792  
000016C4                           793  ; X-axis: PLAYER_X <= SMALLZOMB_X + WIDTH
000016C4  2239 00001AB0            794      MOVE.L  PLAYER_X, D1
000016CA  2439 00001ACC            795      MOVE.L  SMALLZOMB_X, D2
000016D0  D4B8 0008                796      ADD.L   SMALLZOMB_W_INIT, D2
000016D4  B481                     797      CMP.L   D1, D2
000016D6  6E00 004C                798      BGT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
000016DA                           799  
000016DA                           800  ; X-axis: PLAYER_X + PLAYER_W >= SMALLZOMB_X
000016DA  2239 00001AB0            801      MOVE.L  PLAYER_X, D1
000016E0  D2B8 0008                802      ADD.L   PLYR_W_INIT, D1
000016E4  2439 00001ACC            803      MOVE.L  SMALLZOMB_X, D2
000016EA  B481                     804      CMP.L   D1, D2
000016EC  6D00 0036                805      BLT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
000016F0                           806  
000016F0                           807  ; Y-axis: PLAYER_Y <= SMALLZOMB_Y + HEIGHT
000016F0  2239 00001AB4            808      MOVE.L  PLAYER_Y, D1
000016F6  2439 00001AD0            809      MOVE.L  SMALLZOMB_Y, D2
000016FC  D4B8 0008                810      ADD.L   SMALLZOMB_H_INIT, D2
00001700  B481                     811      CMP.L   D1, D2
00001702  6E00 0020                812      BGT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
00001706                           813  
00001706                           814  ; Y-axis: PLAYER_Y + PLAYER_H >= SMALLZOMB_Y
00001706  2239 00001AB4            815      MOVE.L  PLAYER_Y, D1
0000170C  D2B8 0008                816      ADD.L   PLYR_H_INIT, D1
00001710  2439 00001AD0            817      MOVE.L  SMALLZOMB_Y, D2
00001716  B481                     818      CMP.L   D1, D2
00001718  6D00 000A                819      BLT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
0000171C                           820  
0000171C                           821  ; Collision confirmed!
0000171C  6100 0114                822      BSR     SMALLZOMB_COLLISION
00001720  6000 0102                823      BRA     COLLISION_CHECK_DONE
00001724                           824  
00001724                           825  ; -----------------------------
00001724                           826  ; Check Large Zombie Collision
00001724                           827  ; -----------------------------
00001724                           828  CHECK_LARGEZOMB_COLLISION:
00001724  4281                     829      CLR.L   D1
00001726  4282                     830      CLR.L   D2
00001728                           831  
00001728                           832  ; X-axis: PLAYER_X <= LARGEZOMB_X + WIDTH
00001728  2239 00001AB0            833      MOVE.L  PLAYER_X, D1
0000172E  2439 00001AD8            834      MOVE.L  LARGEZOMB_X, D2
00001734  D4B8 0010                835      ADD.L   LARGEZOMB_W_INIT, D2
00001738  B481                     836      CMP.L   D1, D2
0000173A  6E00 0048                837      BGT     CHECK_FUEL_COLLISION  ; skip if no overlap
0000173E                           838  
0000173E                           839  ; X-axis: PLAYER_X + PLAYER_W >= LARGEZOMB_X
0000173E  2239 00001AB0            840      MOVE.L  PLAYER_X, D1
00001744  D2B8 0008                841      ADD.L   PLYR_W_INIT, D1
00001748  2439 00001AD8            842      MOVE.L  LARGEZOMB_X, D2
0000174E  B481                     843      CMP.L   D1, D2
00001750  6D00 0032                844      BLT     CHECK_FUEL_COLLISION  ; skip if no overlap
00001754                           845  
