00001488                           530  * Subroutine    : Player is on Ground
00001488                           531  * Description   : Check if the Player is on or off Ground
00001488                           532  *-----------------------------------------------------------
00001488                           533  IS_PLAYER_ON_GND:
00001488                           534      ; Check if Player is on Ground
00001488  4281                     535      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
0000148A  4282                     536      CLR.L   D2                      ; Clear contents of D2 (XOR is faster)
0000148C  3239 00001AAA            537      MOVE.W  SCREEN_H,   D1          ; Place Screen width in D1
00001492  82FC 0002                538      DIVU    #02,        D1          ; divide by 2 for center on Y Axis
00001496  2439 00001AB4            539      MOVE.L  PLAYER_Y,   D2          ; Player Y Position
0000149C  B481                     540      CMP.L   D1,         D2        ; Compare middle of Screen with Players Y Position 
0000149E  6D00 002A                541      BLT     SET_OFF_GROUND           ; The Player is on the Ground Plane
000014A2  6000 0002                542      BRA     SET_ON_GROUND          ; The Player is off the Ground
000014A6                           543                                
000014A6                           544  
