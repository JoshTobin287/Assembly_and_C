00001AA1                          1032  *-----------------------------------------------------------
00001AA1                          1033  * Section       : Graphic Colors
00001AA1                          1034  * Description   : Screen Pixel Color
00001AA1                          1035  *-----------------------------------------------------------
00001AA1  =00FFFFFF               1036  WHITE           EQU     $00FFFFFF   ;white color for player
00001AA1  =000000FF               1037  RED             EQU     $000000FF   ;red color for zombies
00001AA1  =0000FF00               1038  GREEN           EQU     $0000FF00  ; Green color for fuel
00001AA1  =80FFFFFF               1039  GREY            EQU     $80FFFFFF     ;grey color for repair kit 
00001AA1                          1040  
00001AA1                          1041  *-----------------------------------------------------------
00001AA1                          1042  * Section       : Screen Size
00001AA1                          1043  * Description   : Screen Width and Height
00001AA1                          1044  *-----------------------------------------------------------
00001AA2                          1045  SCREEN_W        DS.W    01  ; Reserve Space for Screen Width
00001AA4                          1046  SCREEN_H        DS.W    01  ; Reserve Space for Screen Height
00001AA6                          1047  
00001AA6                          1048  *-----------------------------------------------------------
00001AA6                          1049  * Section       : Keyboard Input
00001AA6                          1050  * Description   : Used for storing Keypresses
00001AA6                          1051  *-----------------------------------------------------------
00001AA6                          1052  CURRENT_KEY     DS.L    01  ; Reserve Space for Current Key Pressed
00001AAA                          1053  
00001AAA                          1054  *-----------------------------------------------------------
00001AAA                          1055  * Section       : Character Positions
00001AAA                          1056  * Description   : Player and Enemy Position Memory Locations
00001AAA                          1057  *-----------------------------------------------------------
00001AAA                          1058  PLAYER_X        DS.L    01  ; Reserve Space for Player X Position
00001AAE                          1059  PLAYER_Y        DS.L    01  ; Reserve Space for Player Y Position
00001AB2                          1060  JUMP_TIMER      DS.L    01  ; Jump cooldown timer
00001AB6                          1061  PLAYER_SCORE    DS.L    01  ; Reserve Space for Player Score
00001ABA                          1062  
00001ABA                          1063  PLYR_VELOCITY   DS.L    01  ; Reserve Space for Player Velocity
00001ABE                          1064  PLYR_GRAVITY    DS.L    01  ; Reserve Space for Player Gravity
00001AC2                          1065  PLYR_ON_GND     DS.L    01  ; Reserve Space for Player on Ground
00001AC6                          1066  
00001AC6                          1067  SMALLZOMB_X     DS.L    01  ; Reserve Space for small zombie X Position
00001ACA                          1068  SMALLZOMB_Y     DS.L    01  ; Reserve Space for small zombie Y Position
00001ACE                          1069  
00001ACE= 00000000                1070  ZOMBIE_SOUND_ACTIVE  DC.l 0   ; 0 = sound not playing, 1 = playing
00001AD2                          1071  
00001AD2                          1072  LARGEZOMB_X     DS.L    01  ; Reserve Space for large zombie X Position
00001AD6                          1073  LARGEZOMB_Y     DS.L    01  ; Reserve Space for large zombie Y Position
00001ADA                          1074  
00001ADA                          1075  BUILDING_X      DS.L    01    ; X position
00001ADE                          1076  BUILDING_Y      DS.L    01   ; Y position 
00001AE2                          1077  
00001AE2                          1078  ROAD_Y          DS.L    1       ; Y position of road 
00001AE6                          1079  
00001AE6= 00000001                1080  HULL_INTEGRITY  DC.L    01      ;
00001AEA                          1081  
00001AEA                          1082  KILL_COUNT      DS.L    01  ; reserve space for kill counter
00001AEE                          1083  FUEL            DS.L    01  ; Player fuel
00001AF2                          1084  FUEL_TIMER      DS.L    01   ; Counts frames for fuel decrease
00001AF6                          1085  FUEL_RESPAWN_TIMER   DS.L   1
00001AFA                          1086  
00001AFA                          1087  FUEL_X         DS.L  1  ; Fuel X position
00001AFE                          1088  FUEL_Y         DS.L  1  ; Fuel Y position
00001B02                          1089  FUEL_ACTIVE    DS.L  1  ; 1 if visible, 0 if not
00001B06  =0000000A               1090  FUEL_AMOUNT    EQU    10 ; How much fuel is restored when collected
