000013FA                           494  *-----------------------------------------------------------
000013FA                           495  * Subroutine    : Draw Player Data
000013FA                           496  * Description   : Draw Player X, Y, Velocity, Gravity and OnGround
000013FA                           497  *-----------------------------------------------------------
000013FA                           498  DRAW_PLYR_DATA:
000013FA  4281                     499      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
000013FC                           500  
000013FC                           501      ; Display Kill Counter
000013FC  103C 000B                502      MOVE.B #TC_CURSR_P, D0       ; Set cursor
00001400  323C 0201                503      MOVE.W #$0201, D1            ; Row 1, Column 2
00001404  4E4F                     504      TRAP #15                      ; Position cursor
00001406  43F9 000019F5            505      LEA KILL_MSG, A1              ; "Kills: " message
0000140C  303C 000D                506      MOVE #13, D0                  ; No line feed
00001410  4E4F                     507      TRAP #15                      ; Print message
00001412                           508  
00001412  103C 000B                509      MOVE.B #TC_CURSR_P, D0       ; Set cursor
00001416  323C 0801                510      MOVE.W #$0801, D1            ; Row 1, Column 8 (after "Kills: ")
0000141A  4E4F                     511      TRAP #15                      ; Position cursor
0000141C  2239 00001AEA            512      MOVE.L KILL_COUNT, D1        ; Load kill count
00001422  103C 0003                513      MOVE.B #03, D0                ; Display as number
00001426  4E4F                     514      TRAP #15                      ; Print count
00001428                           515  
00001428                           516      ; display fuel
00001428  103C 000B                517      MOVE.B  #TC_CURSR_P, D0
0000142C  323C 0202                518      MOVE.W  #$0202, D1              ; column 2, row 2
00001430  4E4F                     519      TRAP    #15
00001432  43F9 00001A11            520      LEA     FUEL_MSG_LABEL, A1      ; pointer to "Fuel: "
00001438  303C 000D                521      MOVE    #13, D0                 ; no linefeed
0000143C  4E4F                     522      TRAP    #15
0000143E                           523  
0000143E  103C 000B                524      MOVE.B  #TC_CURSR_P, D0
00001442  323C 0902                525      MOVE.W  #$0902, D1              ; column 9, row 2 for value
00001446  4E4F                     526      TRAP    #15
00001448  2239 00001AEE            527      MOVE.L  FUEL, D1                ; current fuel value
0000144E  103C 0003                528      MOVE.B  #03, D0                 ; display as number
00001452  4E4F                     529      TRAP    #15
00001454                           530      
00001454                           531      ; display hull integrity
00001454  103C 000B                532      MOVE.B  #TC_CURSR_P, D0
00001458  323C 0203                533      MOVE.W  #$0203, D1              ; c
0000145C  4E4F                     534      TRAP    #15
0000145E  43F9 00001A18            535      LEA     HULL_INTEGRITY_LABEL, A1      ; pointer to "Hull Integrity: "
00001464  303C 000D                536      MOVE    #13, D0                 ; no linefeed
00001468  4E4F                     537      TRAP    #15
0000146A                           538  
0000146A  103C 000B                539      MOVE.B  #TC_CURSR_P, D0
0000146E  323C 1003                540      MOVE.W  #$1003, D1              ; 
