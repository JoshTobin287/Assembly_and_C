00001200  4E4F                     289      TRAP    #15                     ; Trap (Perform action)
00001202  1401                     290      MOVE.B  D1,         D2          ; Move last key D1 to D2
00001204  B43C 0000                291      CMP.B   #00,        D2          ; Key is pressed
00001208  6700 000E                292      BEQ     PROCESS_INPUT ; Process Key
0000120C  4E4F                     293      TRAP    #15                     ; Trap for Last Key
0000120E                           294      ; Check if key still pressed
0000120E  B23C 00FF                295      CMP.B   #$FF,       D1          ; Is it still pressed
00001212  6700 0004                296      BEQ     PROCESS_INPUT           ; Process Last Key
00001216  4E75                     297      RTS                             ; Return to subroutine
00001218                           298  
