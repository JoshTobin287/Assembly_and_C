00001382  4281                     439      CLR.L   D1                  ; Clear D1 register 
00001384  3239 00001AA2            440      MOVE.W  SCREEN_W, D1        ; Load screen width into D1 
0000138A  23C1 00001AC6            441      MOVE.L  D1, SMALLZOMB_X     ; Set small zombie's X position to right side of screen
00001390                           442  
00001390                           443      ; Reset Y position to middle of screen
00001390  4281                     444      CLR.L   D1                  ; Clear D1 again
00001392  3239 00001AA4            445      MOVE.W  SCREEN_H, D1        ; Load screen height into D1
00001398  82FC 0002                446      DIVU    #2, D1              ; Divide D1 by 2 to get middle of screen
0000139C  23C1 00001ACA            447      MOVE.L  D1, SMALLZOMB_Y     ; Set small zombie's Y position to vertical center
000013A2                           448  
000013A2  4E75                     449      RTS                         ; Return from subroutine
000013A4                           450  
000013A4                           451  *-----------------------------------------------------------
