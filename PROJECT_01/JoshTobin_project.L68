000014D0                           586  *-----------------------------------------------------------
000014D0                           587  * Subroutine    : Jump
000014D0                           588  * Description   : Perform a Jump
000014D0                           589  *-----------------------------------------------------------
000014D0                           590  JUMP:
000014D0  0CB9 00000001 00001AC2   591      CMP.L   #GND_TRUE, PLYR_ON_GND
000014DA  6600 0028                592      BNE     JUMP_DONE              ; Must be on ground
000014DE                           593  
000014DE  0CB9 00000000 00001AB2   594      CMP.L   #0, JUMP_TIMER
000014E8  6600 001A                595      BNE     JUMP_DONE              ; Cooldown still active
000014EC                           596  
000014EC  6100 0048                597      BSR     PLAY_JUMP
000014F0  23FC FFFFFFE7 00001ABA   598      MOVE.L  #PLYR_JUMP_V, PLYR_VELOCITY
000014FA                           599  
