00001482                           550  * Subroutine    : Player is on Ground
00001482                           551  * Description   : Check if the Player is on or off Ground
00001482                           552  *-----------------------------------------------------------
00001482                           553  IS_PLAYER_ON_GND:
00001482                           554      ; Check if Player is on Ground
00001482  4281                     555      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
00001484  4282                     556      CLR.L   D2                      ; Clear contents of D2 (XOR is faster)
00001486  3239 00001AA4            557      MOVE.W  SCREEN_H,   D1          ; Place Screen width in D1
0000148C  82FC 0002                558      DIVU    #02,        D1          ; divide by 2 for center on Y Axis
00001490  2439 00001AAE            559      MOVE.L  PLAYER_Y,   D2          ; Player Y Position
00001496  B481                     560      CMP.L   D1,         D2        ; Compare middle of Screen with Players Y Position 
00001498  6D00 002A                561      BLT     SET_OFF_GROUND           ; The Player is on the Ground Plane
0000149C  6000 0002                562      BRA     SET_ON_GROUND          ; The Player is off the Ground
000014A0                           563                                
000014A0                           564  
000014A0                           565  
000014A0                           566  *-----------------------------------------------------------
000014A0                           567  * Subroutine    : On Ground
000014A0                           568  * Description   : Set the Player On Ground
000014A0                           569  *-----------------------------------------------------------
000014A0                           570  SET_ON_GROUND:
000014A0  4281                     571      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
000014A2  3239 00001AA4            572      MOVE.W  SCREEN_H,   D1          ; Place Screen width in D1
000014A8  82FC 0002                573      DIVU    #02,        D1          ; divide by 2 for center on Y Axis
000014AC  23C1 00001AAE            574      MOVE.L  D1,         PLAYER_Y    ; Reset the Player Y Position
000014B2  42B9 00001ABA            575      CLR.L   PLYR_VELOCITY                     ; Clear contents of D1 (XOR is faster)
000014B8  23FC 00000001 00001AC2   576      MOVE.L  #GND_TRUE,  PLYR_ON_GND ; Player is on Ground
000014C2  4E75                     577      RTS
000014C4                           578  
