00001336                           386  
00001336                           387      ;Fuel Cowuntdown
00001336  52B9 00001AF8            388      ADD.L   #1, FUEL_TIMER          ; increment timer per update
0000133C  0CB9 0000003C 00001AF8   389      CMP.L   #60, FUEL_TIMER         ; check if ~1 second passed (adjust if needed)
00001346  6D00 0020                390      BLT     SKIP_FUEL_DECREMENT     ; if not, skip decrement
0000134A  53B9 00001AF4            391      SUB.L   #1, FUEL                ; decrease fuel by 1
00001350  42B9 00001AF8            392      CLR.L   FUEL_TIMER              ; reset timer
00001356  0CB9 00000000 00001AF4   393      CMP.L   #0, FUEL
00001360  6E00 0006                394      BGT     SKIP_GAME_OVER          ; if fuel > 0, skip game over
00001364  6100 0538                395      BSR     EXIT                     ; fuel is 0 ? end game
00001368                           396  SKIP_FUEL_DECREMENT:             ; label to continue normal update
00001368                           397  SKIP_GAME_OVER:
00001368                           398              
00001368  4E75                     399      RTS                             ; Return to subroutine  
