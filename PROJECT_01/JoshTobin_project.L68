000016C0                           774  * Subroutine    : Collision Check
000016C0                           775  * Description   : Axis-Aligned Bounding Box Collision Detection
000016C0                           776  * Algorithm checks for overlap on the 4 sides of the Player and 
000016C0                           777  * Enemy rectangles
000016C0                           778  * PLAYER_X <= ENEMY_X + ENEMY_W &&
000016C0                           779  * PLAYER_X + PLAYER_W >= ENEMY_X &&
000016C0                           780  * PLAYER_Y <= ENEMY_Y + ENEMY_H &&
000016C0                           781  * PLAYER_H + PLAYER_Y >= ENEMY_Y
000016C0                           782  *-----------------------------------------------------------
000016C0                           783  CHECK_COLLISIONS:
000016C0                           784  
000016C0                           785  ; -----------------------------
000016C0                           786  ; Check Small Zombie Collision
000016C0                           787  ; -----------------------------
000016C0  4281                     788      CLR.L   D1
000016C2  4282                     789      CLR.L   D2
000016C4                           790  
000016C4                           791  ; X-axis: PLAYER_X <= SMALLZOMB_X + WIDTH
000016C4  2239 00001AB0            792      MOVE.L  PLAYER_X, D1
000016CA  2439 00001ACC            793      MOVE.L  SMALLZOMB_X, D2
000016D0  D4B8 0008                794      ADD.L   SMALLZOMB_W_INIT, D2
000016D4  B481                     795      CMP.L   D1, D2
000016D6  6E00 004C                796      BGT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
000016DA                           797  
000016DA                           798  ; X-axis: PLAYER_X + PLAYER_W >= SMALLZOMB_X
000016DA  2239 00001AB0            799      MOVE.L  PLAYER_X, D1
000016E0  D2B8 0008                800      ADD.L   PLYR_W_INIT, D1
000016E4  2439 00001ACC            801      MOVE.L  SMALLZOMB_X, D2
000016EA  B481                     802      CMP.L   D1, D2
000016EC  6D00 0036                803      BLT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
000016F0                           804  
000016F0                           805  ; Y-axis: PLAYER_Y <= SMALLZOMB_Y + HEIGHT
000016F0  2239 00001AB4            806      MOVE.L  PLAYER_Y, D1
000016F6  2439 00001AD0            807      MOVE.L  SMALLZOMB_Y, D2
000016FC  D4B8 0008                808      ADD.L   SMALLZOMB_H_INIT, D2
00001700  B481                     809      CMP.L   D1, D2
00001702  6E00 0020                810      BGT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
00001706                           811  
00001706                           812  ; Y-axis: PLAYER_Y + PLAYER_H >= SMALLZOMB_Y
00001706  2239 00001AB4            813      MOVE.L  PLAYER_Y, D1
0000170C  D2B8 0008                814      ADD.L   PLYR_H_INIT, D1
00001710  2439 00001AD0            815      MOVE.L  SMALLZOMB_Y, D2
00001716  B481                     816      CMP.L   D1, D2
00001718  6D00 000A                817      BLT     CHECK_LARGEZOMB_COLLISION  ; skip small zombie if no overlap
0000171C                           818  
0000171C                           819  ; Collision confirmed!
0000171C  6100 0114                820      BSR     SMALLZOMB_COLLISION
00001720  6000 0102                821      BRA     COLLISION_CHECK_DONE
00001724                           822  
00001724                           823  ; -----------------------------
00001724                           824  ; Check Large Zombie Collision
00001724                           825  ; -----------------------------
00001724                           826  CHECK_LARGEZOMB_COLLISION:
00001724  4281                     827      CLR.L   D1
00001726  4282                     828      CLR.L   D2
00001728                           829  
00001728                           830  ; X-axis: PLAYER_X <= LARGEZOMB_X + WIDTH
00001728  2239 00001AB0            831      MOVE.L  PLAYER_X, D1
0000172E  2439 00001AD8            832      MOVE.L  LARGEZOMB_X, D2
00001734  D4B8 0010                833      ADD.L   LARGEZOMB_W_INIT, D2
00001738  B481                     834      CMP.L   D1, D2
0000173A  6E00 0048                835      BGT     CHECK_FUEL_COLLISION  ; skip if no overlap
0000173E                           836  
0000173E                           837  ; X-axis: PLAYER_X + PLAYER_W >= LARGEZOMB_X
0000173E  2239 00001AB0            838      MOVE.L  PLAYER_X, D1
00001744  D2B8 0008                839      ADD.L   PLYR_W_INIT, D1
00001748  2439 00001AD8            840      MOVE.L  LARGEZOMB_X, D2
0000174E  B481                     841      CMP.L   D1, D2
00001750  6D00 0032                842      BLT     CHECK_FUEL_COLLISION  ; skip if no overlap
00001754                           843  
