0000176A                           852  
0000176A                           853  
0000176A                           854  ; Y-axis: PLAYER_Y + PLAYER_H >= LARGEZOMB_Y
0000176A  2239 00001AB4            855       MOVE.L  PLAYER_Y, D1
00001770  D2B8 0008                856      ADD.L   PLYR_H_INIT, D1
00001774  2439 00001ADC            857      MOVE.L  LARGEZOMB_Y, D2
