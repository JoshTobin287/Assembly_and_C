000011FA                           265  * Subroutine    : Input
000011FA                           266  * Description   : Process Keyboard Input
000011FA                           267  *-----------------------------------------------------------
000011FA                           268  INPUT:
000011FA                           269      ; Process Input
000011FA  4281                     270      CLR.L   D1                      ; Clear Data Register
000011FC  103C 0013                271      MOVE.B  #TC_KEYCODE,D0          ; Listen for Keys
00001200  4E4F                     272      TRAP    #15                     ; Trap (Perform action)
00001202  1401                     273      MOVE.B  D1,         D2          ; Move last key D1 to D2
00001204  B43C 0000                274      CMP.B   #00,        D2          ; Key is pressed
00001208  6700 000E                275      BEQ     PROCESS_INPUT ; Process Key
0000120C  4E4F                     276      TRAP    #15                     ; Trap for Last Key
0000120E                           277      ; Check if key still pressed
0000120E  B23C 00FF                278      CMP.B   #$FF,       D1          ; Is it still pressed
00001212  6700 0004                279      BEQ     PROCESS_INPUT           ; Process Last Key
00001216  4E75                     280      RTS                             ; Return to subroutine
00001218                           281  
00001218                           282  *-----------------------------------------------------------
00001218                           283  * Subroutine    : Process Input
00001218                           284  * Description   : Branch based on keys pressed
00001218                           285  *-----------------------------------------------------------
00001218                           286  PROCESS_INPUT:
00001218  23C2 00001AAC            287      MOVE.L  D2,         CURRENT_KEY ; Put Current Key in Memory
0000121E  0CB9 0000001B 00001AAC   288      CMP.L   #ESCAPE,    CURRENT_KEY ; Is Current Key Escape
00001228  6700 0674                289      BEQ     EXIT                    ; Exit if Escape
0000122C  0CB9 00000020 00001AAC   290      CMP.L   #SPACEBAR,  CURRENT_KEY ; Is Current Key Spacebar
00001236  6700 029E                291      BEQ     JUMP                    ; Jump
0000123A  4E75                     292      RTS                             ; Return to subroutine
0000123C                           293  
