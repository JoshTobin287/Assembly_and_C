00001488                           528  * Subroutine    : Player is on Ground
00001488                           529  * Description   : Check if the Player is on or off Ground
00001488                           530  *-----------------------------------------------------------
00001488                           531  IS_PLAYER_ON_GND:
00001488                           532      ; Check if Player is on Ground
00001488  4281                     533      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
0000148A  4282                     534      CLR.L   D2                      ; Clear contents of D2 (XOR is faster)
0000148C  3239 00001AAA            535      MOVE.W  SCREEN_H,   D1          ; Place Screen width in D1
00001492  82FC 0002                536      DIVU    #02,        D1          ; divide by 2 for center on Y Axis
00001496  2439 00001AB4            537      MOVE.L  PLAYER_Y,   D2          ; Player Y Position
0000149C  B481                     538      CMP.L   D1,         D2        ; Compare middle of Screen with Players Y Position 
0000149E  6D00 002A                539      BLT     SET_OFF_GROUND           ; The Player is on the Ground Plane
000014A2  6000 0002                540      BRA     SET_ON_GROUND          ; The Player is off the Ground
000014A6                           541                                
000014A6                           542  
000014A6                           543  
000014A6                           544  *-----------------------------------------------------------
000014A6                           545  * Subroutine    : On Ground
000014A6                           546  * Description   : Set the Player On Ground
000014A6                           547  *-----------------------------------------------------------
000014A6                           548  SET_ON_GROUND:
000014A6  4281                     549      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
000014A8  3239 00001AAA            550      MOVE.W  SCREEN_H,   D1          ; Place Screen width in D1
000014AE  82FC 0002                551      DIVU    #02,        D1          ; divide by 2 for center on Y Axis
000014B2  23C1 00001AB4            552      MOVE.L  D1,         PLAYER_Y    ; Reset the Player Y Position
000014B8  42B9 00001AC0            553      CLR.L   PLYR_VELOCITY                     ; Clear contents of D1 (XOR is faster)
000014BE  23FC 00000001 00001AC8   554      MOVE.L  #GND_TRUE,  PLYR_ON_GND ; Player is on Ground
000014C8  4E75                     555      RTS
000014CA                           556  
000014CA                           557  *-----------------------------------------------------------
000014CA                           558  * Subroutine    : Off Ground
000014CA                           559  * Description   : Set the Player Off Ground
000014CA                           560  *-----------------------------------------------------------
000014CA                           561  SET_OFF_GROUND:
000014CA  23FC 00000000 00001AC8   562      MOVE.L  #GND_FALSE, PLYR_ON_GND ; Player if off Ground
000014D4  4E75                     563      RTS                             ; Return to subroutine
000014D6                           564  *-----------------------------------------------------------
000014D6                           565  * Subroutine    : Jump
000014D6                           566  * Description   : Perform a Jump
000014D6                           567  *-----------------------------------------------------------
000014D6                           568  JUMP:
000014D6  0CB9 00000001 00001AC8   569      CMP.L   #GND_TRUE, PLYR_ON_GND
000014E0  6600 0028                570      BNE     JUMP_DONE              ; Must be on ground
000014E4                           571  
000014E4  0CB9 00000000 00001AB8   572      CMP.L   #0, JUMP_TIMER
000014EE  6600 001A                573      BNE     JUMP_DONE              ; Cooldown still active
000014F2                           574  
000014F2  6100 0048                575      BSR     PLAY_JUMP
000014F6  23FC FFFFFFE7 00001AC0   576      MOVE.L  #PLYR_JUMP_V, PLYR_VELOCITY
00001500                           577  
00001500  23FC 00000064 00001AB8   578      MOVE.L  #100, JUMP_TIMER        ; Cooldown length (adjust this)
0000150A                           579  
0000150A                           580  JUMP_DONE:
0000150A  4E75                     581      RTS
0000150C                           582  
