00001650  103C 0057                754      MOVE.B  #87, D0            ; Draw rectangle
00001654  4E4F                     755      TRAP    #15
00001656                           756  SKIP_DRAW_FUEL:
00001656  4E75                     757      RTS
00001658                           758      
00001658                           759  *-------------------------------------------------
00001658                           760  *DRAW_BUILDING
00001658                           761  *--------------------------------------------------
00001658                           762  
00001658                           763  DRAW_BUILDING:
00001658  223C 00FFFFFF            764      MOVE.L #WHITE, D1
0000165E  103C 0050                765      MOVE.B #80, D0      ; Set color
00001662  4E4F                     766      TRAP #15
00001664                           767  
00001664  2239 00001ADA            768      MOVE.L BUILDING_X, D1
0000166A  2439 00001ADE            769      MOVE.L BUILDING_Y, D2
00001670  2639 00001ADA            770      MOVE.L BUILDING_X, D3
00001676  0683 00000032            771      ADD.L #BUILDING_W, D3
0000167C  2839 00001ADE            772      MOVE.L BUILDING_Y, D4
00001682  0684 000000C8            773      ADD.L #BUILDING_H, D4
00001688                           774  
00001688  103C 0057                775      MOVE.B #87, D0      ; Draw rectangle
0000168C  4E4F                     776      TRAP #15
0000168E  4E75                     777      RTS
00001690                           778      
00001690                           779  DRAW_ROAD:
00001690  223C 00FFFFFF            780      MOVE.L #WHITE, D1
00001696  103C 0050                781      MOVE.B #80, D0
0000169A  4E4F                     782      TRAP #15
0000169C                           783  
0000169C  7200                     784      MOVE.L #0, D1             ; X start
0000169E  2439 00001AE2            785      MOVE.L ROAD_Y, D2         ; Y start
000016A4  2639 00001AA2            786      MOVE.L SCREEN_W, D3       ; X end
000016AA  2839 00001AE2            787      MOVE.L ROAD_Y, D4
000016B0  5284                     788      ADD.L #ROAD_HEIGHT, D4    ; Y end
000016B2  103C 0057                789      MOVE.B #87, D0
000016B6  4E4F                     790      TRAP #15
000016B8  4E75                     791      RTS
000016BA                           792  *-----------------------------------------------------------
000016BA                           793  * Subroutine    : Collision Check
000016BA                           794  * Description   : Axis-Aligned Bounding Box Collision Detection
000016BA                           795  * Algorithm checks for overlap on the 4 sides of the Player and 
000016BA                           796  * Enemy rectangles
000016BA                           797  * PLAYER_X <= ENEMY_X + ENEMY_W &&
000016BA                           798  * PLAYER_X + PLAYER_W >= ENEMY_X &&
000016BA                           799  * PLAYER_Y <= ENEMY_Y + ENEMY_H &&
000016BA                           800  * PLAYER_H + PLAYER_Y >= ENEMY_Y
000016BA                           801  *-----------------------------------------------------------
000016BA                           802  CHECK_COLLISIONS:
000016BA                           803  
000016BA                           804  ; -----------------------------
000016BA                           805  ; Check Small Zombie Collision
000016BA                           806  ; -----------------------------
000016BA  4281                     807      CLR.L   D1                  ; Clear D1 to use as temporary register
000016BC  4282                     808      CLR.L   D2                  ; Clear D2 to use as temporary register
000016BE                           809  
000016BE                           810  ; X-axis: Check if player's left side is to the left of small zombie's right side
000016BE  2239 00001AAA            811      MOVE.L  PLAYER_X, D1        ; D1 = PLAYER_X 
000016C4  2439 00001AC6            812      MOVE.L  SMALLZOMB_X, D2     ; D2 = SMALLZOMB_X 
000016CA  D4B8 0008                813      ADD.L   SMALLZOMB_W_INIT, D2 ; D2 = zombie's right X
000016CE  B481                     814      CMP.L   D1, D2              ; Compare player's left X with zombie's right X
000016D0  6E00 004C                815      BGT     CHECK_LARGEZOMB_COLLISION  ; If player is completely to the right, skip
000016D4                           816  
000016D4                           817  ; X-axis: Check if player's right side is to the right of small zombie's left side
000016D4  2239 00001AAA            818      MOVE.L  PLAYER_X, D1        ; D1 = PLAYER_X
000016DA  D2B8 0008                819      ADD.L   PLYR_W_INIT, D1     ; D1 = player's right X
000016DE  2439 00001AC6            820      MOVE.L  SMALLZOMB_X, D2     ; D2 = zombie's left X
000016E4  B481                     821      CMP.L   D1, D2              ; Compare player's right X with zombie's left X
000016E6  6D00 0036                822      BLT     CHECK_LARGEZOMB_COLLISION  ; If player is completely to the left, skip
000016EA                           823  
000016EA                           824  ; Y-axis: Check if player's top is above small zombie's bottom
000016EA  2239 00001AAE            825      MOVE.L  PLAYER_Y, D1        ; D1 = PLAYER_Y 
000016F0  2439 00001ACA            826      MOVE.L  SMALLZOMB_Y, D2     ; D2 = zombie's top Y
000016F6  D4B8 0008                827      ADD.L   SMALLZOMB_H_INIT, D2 ; D2 = zombie's bottom Y
000016FA  B481                     828      CMP.L   D1, D2              ; Compare player's top Y with zombie's bottom Y
000016FC  6E00 0020                829      BGT     CHECK_LARGEZOMB_COLLISION  ; If player is below zombie, skip
00001700                           830  
00001700                           831  ; Y-axis: Check if player's bottom is below small zombie's top
00001700  2239 00001AAE            832      MOVE.L  PLAYER_Y, D1        ; D1 = PLAYER_Y
00001706  D2B8 0008                833      ADD.L   PLYR_H_INIT, D1     ; D1 = player's bottom Y
0000170A  2439 00001ACA            834      MOVE.L  SMALLZOMB_Y, D2     ; D2 = zombie's top Y
00001710  B481                     835      CMP.L   D1, D2              ; Compare player's bottom Y with zombie's top Y
00001712  6D00 000A                836      BLT     CHECK_LARGEZOMB_COLLISION  ; If player is above zombie, skip
00001716                           837  
00001716                           838  ; Collision confirmed for small zombie
00001716  6100 0114                839      BSR     SMALLZOMB_COLLISION ; Call small zombie collision handler
0000171A  6000 0102                840      BRA     COLLISION_CHECK_DONE ; Skip large zombie check after collision
0000171E                           841  
0000171E                           842  ; -----------------------------
0000171E                           843  ; Check Large Zombie Collision
0000171E                           844  ; -----------------------------
0000171E                           845  CHECK_LARGEZOMB_COLLISION:
0000171E  4281                     846      CLR.L   D1                  ; Clear D1
00001720  4282                     847      CLR.L   D2                  ; Clear D2
00001722                           848  
00001722                           849  ; X-axis: Check if player's left side is to the left of large zombie's right side
00001722  2239 00001AAA            850      MOVE.L  PLAYER_X, D1
00001728  2439 00001AD2            851      MOVE.L  LARGEZOMB_X, D2
0000172E  D4B8 0010                852      ADD.L   LARGEZOMB_W_INIT, D2
00001732  B481                     853      CMP.L   D1, D2
00001734  6E00 0048                854      BGT     CHECK_FUEL_COLLISION  ; Skip if no horizontal overlap
00001738                           855  
00001738                           856  ; X-axis: Check if player's right side is to the right of large zombie's left side
00001738  2239 00001AAA            857      MOVE.L  PLAYER_X, D1
0000173E  D2B8 0008                858      ADD.L   PLYR_W_INIT, D1
00001742  2439 00001AD2            859      MOVE.L  LARGEZOMB_X, D2
00001748  B481                     860      CMP.L   D1, D2
0000174A  6D00 0032                861      BLT     CHECK_FUEL_COLLISION  ; Skip if no horizontal overlap
0000174E                           862  
0000174E                           863  ; Y-axis: Check if player's top is above large zombie's bottom
0000174E  2239 00001AAE            864      MOVE.L  PLAYER_Y, D1
00001754  2439 00001AD6            865      MOVE.L  LARGEZOMB_Y, D2
0000175A  D4B8 0016                866      ADD.L   LARGEZOMB_H_INIT, D2
0000175E  B481                     867      CMP.L   D1, D2
00001760  6E00 001C                868      BGT     CHECK_FUEL_COLLISION  ; Skip if no vertical overlap
00001764                           869  
00001764                           870  ; Y-axis: Check if player's bottom is below large zombie's top
00001764  2239 00001AAE            871      MOVE.L  PLAYER_Y, D1
0000176A  D2B8 0008                872      ADD.L   PLYR_H_INIT, D1
0000176E  2439 00001AD6            873      MOVE.L  LARGEZOMB_Y, D2
00001774  B481                     874      CMP.L   D1, D2
00001776  6D00 0006                875      BLT     CHECK_FUEL_COLLISION  ; Skip if no vertical overlap
0000177A                           876  
0000177A  6100 00DC                877      BSR     LARGEZOMB_COLLISION ; Call large zombie collision 
0000177E                           878  ; -----------------------------
0000177E                           879  ; Check Fuel Collision
0000177E                           880  ; ----------------------------- 
0000177E                           881  CHECK_FUEL_COLLISION:
0000177E                           882  
0000177E  0CB9 00000001 00001B02   883      CMP.L   #1, FUEL_ACTIVE          ; Is the fuel currently visible?
00001788  6600 0094                884      BNE     COLLISION_CHECK_DONE    ; If not active, skip collision check
0000178C                           885  
0000178C  4281                     886      CLR.L   D1                        ; Clear D1 for calculations
0000178E  4282                     887      CLR.L   D2                        ; Clear D2 for calculations
00001790                           888  
00001790                           889  
00001790                           890      ; Check X-axis overlap
00001790  2239 00001AAA            891      MOVE.L  PLAYER_X, D1              ; Load player X position
00001796  2439 00001AFA            892      MOVE.L  FUEL_X, D2                ; Load fuel X position
0000179C  D4B8 0008                893      ADD.L   FUEL_W_INIT, D2           ; Add fuel width to get right edge
000017A0  B481                     894      CMP.L   D1, D2                     ; Compare left side of player with right side of fuel
000017A2  6F00 0006                895      BLE     FUEL_X2_CHECK              ; If player left <= fuel right, continue X check
000017A6  6000 0076                896      BRA     COLLISION_CHECK_DONE         ; Otherwise, no collision
000017AA                           897  
000017AA                           898  FUEL_X2_CHECK:
000017AA                           899      ; Check second X-axis overlap: PLAYER_X + PLAYER_W_INIT >= FUEL_X
000017AA  D2B8 0008                900      ADD.L   PLYR_W_INIT, D1           ; Add player width to get right side of player
000017AE  2439 00001AFA            901      MOVE.L  FUEL_X, D2                ; Reload fuel X
000017B4  B481                     902      CMP.L   D1, D2                     ; Compare right side of player to left side of fuel
000017B6  6C00 0006                903      BGE     FUEL_Y1_CHECK              ; If player right >= fuel left, continue Y check
000017BA  6000 0062                904      BRA     COLLISION_CHECK_DONE        ; Otherwise, no collision
000017BE                           905  
000017BE                           906  FUEL_Y1_CHECK:
000017BE                           907      ; Check Y-axis overlap: PLAYER_Y <= FUEL_Y + FUEL_H_INIT
000017BE  2239 00001AAE            908      MOVE.L  PLAYER_Y, D1              ; Load player Y position
000017C4  2439 00001AFE            909      MOVE.L  FUEL_Y, D2                ; Load fuel Y position
000017CA  D4B8 000E                910      ADD.L   FUEL_H_INIT, D2           ; Add fuel height to get bottom of fuel
000017CE  B481                     911      CMP.L   D1, D2                     ; Compare top of player with bottom of fuel
000017D0  6F00 0006                912      BLE     FUEL_Y2_CHECK              ; If player top <= fuel bottom, continue Y check
000017D4  6000 0048                913      BRA     COLLISION_CHECK_DONE       ; Otherwise, no collision
000017D8                           914  
000017D8                           915  FUEL_Y2_CHECK:
000017D8                           916      ; Check second Y-axis overlap
000017D8  D2B8 0008                917      ADD.L   PLYR_H_INIT, D1           ; Add player height to get bottom of player
000017DC  2439 00001AFE            918      MOVE.L  FUEL_Y, D2                ; Reload fuel Y
000017E2  B481                     919      CMP.L   D1, D2                     ; Compare bottom of player with top of fuel
000017E4  6C00 0006                920      BGE     FUEL_COLLECTED             ; If overlap confirmed, fuel collected
000017E8  6000 0034                921      BRA     COLLISION_CHECK_DONE         ; Otherwise, no collision
000017EC                           922  
000017EC                           923  FUEL_COLLECTED:
000017EC                           924      ;Fuel collected, update fuel and hide
000017EC  2239 00001AEE            925      MOVE.L  FUEL, D1                  ; Load current fuel amount
000017F2  0681 0000000C            926      ADD.L   #12, D1                   ; Add 15 fuel (adjustable)
000017F8  B2BC 00000064            927      CMP.L   #FUEL_MAX,  D1                   ;check if it goes over max
000017FE  6F00 0004                928      BLE     FUEL_OK                     ;if fuel is is <= 100, then ok
00001802  7264                     929      MOVE.L  #FUEL_MAX,  D1                ;otherwise stay to 100
00001804                           930  FUEL_OK:
00001804  23C1 00001AEE            931      MOVE.L  D1, FUEL
0000180A  23FC 00000000 00001B02   932      MOVE.L  #0, FUEL_ACTIVE           ; Hide fuel until next respawn
00001814  42B9 00001AF6            933      CLR.L   FUEL_RESPAWN_TIMER        ; Reset respawn timer
0000181A  6000 0002                934      BRA     COLLISION_CHECK_DONE      ; Finish fuel collision check
0000181E                           935      
0000181E                           936  COLLISION_CHECK_DONE:
0000181E                           937  
0000181E                           938      ; Continue normal collision logic
0000181E  D2B9 00001AB6            939      ADD.L   PLAYER_SCORE, D1          ; Update player score
00001824  23C1 00001AB6            940      MOVE.L  D1, PLAYER_SCORE
0000182A  4E75                     941      RTS                                ; Return from subroutine
0000182C                           942  ; ENEMY COLLISION RESPONSE
0000182C                           943  
0000182C                           944  SMALLZOMB_COLLISION:
0000182C  6100 FD26                945      BSR     PLAY_OPPS
00001830  23FC 00000000 00001AB6   946      MOVE.L  #0, PLAYER_SCORE
0000183A                           947      ;small zombie kill count
0000183A                           948      
0000183A  2239 00001AEA            949      MOVE.L  KILL_COUNT, D1
00001840  5281                     950      ADD.L   #1, D1
00001842  23C1 00001AEA            951      MOVE.L  D1, KILL_COUNT
00001848                           952      ;reset small zombie psoiton
00001848                           953      
00001848  3239 00001AA2            954      MOVE.W  SCREEN_W, D1
0000184E  23C1 00001AC6            955      MOVE.L  D1, SMALLZOMB_X
00001854  6000 FF28                956      BRA     CHECK_FUEL_COLLISION
00001858                           957      
00001858                           958  LARGEZOMB_COLLISION:
00001858  6100 FCFA                959      BSR     PLAY_OPPS
0000185C                           960      ; Reduce hull integrity
0000185C  2239 00001AE6            961      MOVE.L  HULL_INTEGRITY, D1
00001862  0481 0000000A            962      SUB.L   #10, D1           ; Damage value
00001868  B2BC 00000000            963      CMP.L   #0, D1
0000186E  6C00 0004                964      BGE     HULL_OK
00001872  7200                     965      MOVE.L  #0, D1            ; Hull cannot go below 0
00001874                           966  HULL_OK:
00001874  23C1 00001AE6            967      MOVE.L  D1, HULL_INTEGRITY
0000187A                           968      
0000187A  0CB9 00000000 00001AE6   969      CMP.L   #0, HULL_INTEGRITY        ; Is hull 0?
00001884  6700 0012                970      BEQ     EXIT                       ; If yes, go to exit and end game
00001888                           971  
00001888                           972      ; Reset large zombie X position
00001888  3239 00001AA2            973      MOVE.W  SCREEN_W, D1
0000188E  23C1 00001AD2            974      MOVE.L  D1, LARGEZOMB_X
00001894  6000 FEE8                975      BRA     CHECK_FUEL_COLLISION    
00001898                           976      
00001898                           977  *-----------------------------------------------------------
00001898                           978  * Subroutine    : EXIT
00001898                           979  * Description   : Exit message and End Game
00001898                           980  *-----------------------------------------------------------
00001898                           981  EXIT:
00001898                           982      ; Show if Exiting is Running
00001898  103C 000B                983      MOVE.B  #TC_CURSR_P,D0          ; Set Cursor Position
0000189C  323C 4004                984      MOVE.W  #$4004,     D1          ; Col 40, Row 1
000018A0  4E4F                     985      TRAP    #15                     ; Trap (Perform action)
000018A2  43F9 00001A95            986      LEA     EXIT_MSG,   A1          ; Exit
000018A8  303C 000D                987      MOVE    #13,        D0          ; No Line feed
000018AC  4E4F                     988      TRAP    #15                     ; Trap (Perform action)
000018AE                           989      
000018AE  103C 0009                990      MOVE.B  #TC_EXIT,   D0          ; Exit Code
000018B2  4E4F                     991      TRAP    #15                     ; Trap (Perform action)
000018B4                           992      
000018B4  FFFF FFFF                993      SIMHALT
000018B8                           994  
