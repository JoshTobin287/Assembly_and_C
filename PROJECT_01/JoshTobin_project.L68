0000131C                           376      ; Reset building if it is offscreen (like small zombie)
0000131C  0CB9 00000000 00001AE0   377      CMP.L #0, BUILDING_X
00001326  6C00 000E                378      BGE SKIP_BUILDING_RESET
0000132A                           379      ; Offscreen: reset to right side
0000132A  3239 00001AA8            380      MOVE.W SCREEN_W, D1
00001330  23C1 00001AE0            381      MOVE.L D1, BUILDING_X
00001336                           382  
00001336                           383  SKIP_BUILDING_RESET:
00001336                           384  
00001336                           385      ;Fuel Cowuntdown
00001336  52B9 00001B0C            386      ADD.L   #1, FUEL_TIMER          ; increment timer per update
0000133C  0CB9 0000003C 00001B0C   387      CMP.L   #60, FUEL_TIMER         ; check if ~1 second passed (adjust if needed)
00001346  6D00 0020                388      BLT     SKIP_FUEL_DECREMENT     ; if not, skip decrement
0000134A  53B9 00001B08            389      SUB.L   #1, FUEL                ; decrease fuel by 1
00001350  42B9 00001B0C            390      CLR.L   FUEL_TIMER              ; reset timer
00001356  0CB9 00000000 00001B08   391      CMP.L   #0, FUEL
00001360  6E00 0006                392      BGT     SKIP_GAME_OVER          ; if fuel > 0, skip game over
00001364  6100 0538                393      BSR     EXIT                     ; fuel is 0 ? end game
00001368                           394  SKIP_FUEL_DECREMENT:             ; label to continue normal update
00001368                           395  SKIP_GAME_OVER:
00001368                           396              
00001368  4E75                     397      RTS                             ; Return to subroutine  
