00001218                           303  PROCESS_INPUT:
00001218  23C2 00001AA6            304      MOVE.L  D2,         CURRENT_KEY ; Put Current Key in Memory
0000121E  0CB9 0000001B 00001AA6   305      CMP.L   #ESCAPE,    CURRENT_KEY ; Is Current Key Escape
00001228  6700 066E                306      BEQ     EXIT                    ; Exit if Escape
