000013D2                           447  * Subroutine    : Draw
000013D2                           448  * Description   : Draw Screen
000013D2                           449  *-----------------------------------------------------------
000013D2                           450  DRAW: 
000013D2                           451      ; Enable back buffer
000013D2  103C 005E                452      MOVE.B  #94,        D0
000013D6  4E4F                     453      TRAP    #15
000013D8                           454  
000013D8                           455      ; Clear the screen
000013D8  103C 000B                456      MOVE.B  #TC_CURSR_P,D0          ; Set Cursor Position
000013DC  323C FF00                457      MOVE.W  #$FF00,     D1          ; Clear contents
000013E0  4E4F                     458      TRAP    #15                     ; Trap (Perform action)
000013E2                           459      
000013E2  6100 02B2                460      BSR     DRAW_ROAD
000013E6  6100 0276                461      BSR     DRAW_BUILDING
000013EA  6100 0014                462      BSR     DRAW_PLYR_DATA          ; Draw Draw Score, HUD, Player X and Y
000013EE  6100 0194                463      BSR     DRAW_PLAYER             ; Draw Player
000013F2  6100 01C0                464      BSR     DRAW_SMALLZOMB          ; Draw small zombie
000013F6  6100 01EC                465      BSR     DRAW_LARGEZOMB          ; Draw large zombie
000013FA                           466      
000013FA                           467      ;Draw Fuel and Repair Kits
000013FA  6100 0220                468      BSR     DRAW_FUEL
000013FE                           469  
000013FE                           470  
000013FE  4E75                     471      RTS                             ; Return to subroutine
00001400                           472  *-----------------------------------------------------------
00001400                           473  * Subroutine    : Draw Player Data
00001400                           474  * Description   : Draw Player X, Y, Velocity, Gravity and OnGround
00001400                           475  *-----------------------------------------------------------
00001400                           476  DRAW_PLYR_DATA:
00001400  4281                     477      CLR.L   D1                      ; Clear contents of D1 (XOR is faster)
00001402                           478  
00001402                           479      ; Display Kill Counter
00001402  103C 000B                480      MOVE.B #TC_CURSR_P, D0       ; Set cursor
00001406  323C 0201                481      MOVE.W #$0201, D1            ; Row 1, Column 2
0000140A  4E4F                     482      TRAP #15                      ; Position cursor
0000140C  43F9 000019FB            483      LEA KILL_MSG, A1              ; "Kills: " message
00001412  303C 000D                484      MOVE #13, D0                  ; No line feed
00001416  4E4F                     485      TRAP #15                      ; Print message
00001418                           486  
00001418  103C 000B                487      MOVE.B #TC_CURSR_P, D0       ; Set cursor
0000141C  323C 0801                488      MOVE.W #$0801, D1            ; Row 1, Column 8 (after "Kills: ")
00001420  4E4F                     489      TRAP #15                      ; Position cursor
00001422  2239 00001B04            490      MOVE.L KILL_COUNT, D1        ; Load kill count
00001428  103C 0003                491      MOVE.B #03, D0                ; Display as number
0000142C  4E4F                     492      TRAP #15                      ; Print count
0000142E                           493  
0000142E                           494      ; display fuel
0000142E  103C 000B                495      MOVE.B  #TC_CURSR_P, D0
00001432  323C 0202                496      MOVE.W  #$0202, D1              ; column 2, row 2
00001436  4E4F                     497      TRAP    #15
00001438  43F9 00001A17            498      LEA     FUEL_MSG_LABEL, A1      ; pointer to "Fuel: "
0000143E  303C 000D                499      MOVE    #13, D0                 ; no linefeed
00001442  4E4F                     500      TRAP    #15
00001444                           501  
00001444  103C 000B                502      MOVE.B  #TC_CURSR_P, D0
00001448  323C 0902                503      MOVE.W  #$0902, D1              ; column 9, row 2 for value
0000144C  4E4F                     504      TRAP    #15
0000144E  2239 00001B08            505      MOVE.L  FUEL, D1                ; current fuel value
00001454  103C 0003                506      MOVE.B  #03, D0                 ; display as number
00001458  4E4F                     507      TRAP    #15
0000145A                           508      
0000145A                           509      ; display hull integrity
0000145A  103C 000B                510      MOVE.B  #TC_CURSR_P, D0
0000145E  323C 0203                511      MOVE.W  #$0203, D1              ; c
00001462  4E4F                     512      TRAP    #15
00001464  43F9 00001A1E            513      LEA     HULL_INTEGRITY_LABEL, A1      ; pointer to "Hull Integrity: "
0000146A  303C 000D                514      MOVE    #13, D0                 ; no linefeed
0000146E  4E4F                     515      TRAP    #15
00001470                           516  
00001470  103C 000B                517      MOVE.B  #TC_CURSR_P, D0
00001474  323C 1003                518      MOVE.W  #$1003, D1              ; 
00001478  4E4F                     519      TRAP    #15
0000147A  2239 00001B00            520      MOVE.L  HULL_INTEGRITY, D1                ; current fuel value
00001480  103C 0003                521      MOVE.B  #03, D0                 ; display as number
00001484  4E4F                     522      TRAP    #15
00001486                           523  
00001486                           524   
00001486  4E75                     525      RTS  
