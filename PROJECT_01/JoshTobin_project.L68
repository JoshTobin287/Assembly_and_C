000011E8  6100 0052                275      BSR     UPDATE                  ; Update positions and points
000011EC  6100 0294                276      BSR     IS_PLAYER_ON_GND        ; Check if player is on ground
000011F0  6100 04C8                277      BSR     CHECK_COLLISIONS        ; Check for Collisions
000011F4  6100 01D6                278      BSR     DRAW                    ; Draw the Scene
000011F8  60EA                     279      BRA     GAMELOOP                ; Loop back to GameLoop
