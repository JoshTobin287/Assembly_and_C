0000181A  42B9 00001B10            917      CLR.L   FUEL_RESPAWN_TIMER        ; Reset respawn timer
00001820  6000 0002                918      BRA     COLLISION_CHECK_DONE      ; Finish fuel collision check
00001824                           919      
